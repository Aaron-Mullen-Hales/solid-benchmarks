#!/bin/bash

# Source required functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions
source solids4FoamScripts.sh

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PLOT_DIR="${SCRIPT_DIR}/plotscripts"
MESH_SPACING_FILE="${PLOT_DIR}/meshSpacing.csv"
BENCHMARK_FILE="${PLOT_DIR}/Bijelona.csv"

cd "${SCRIPT_DIR}" || exit 1

# Define configurations as space-separated strings
configs=(
    "BASE=base/hex.snes NAME=hex_snes__rhiechow   SOLIDPROPS_TAG=rhiechow   PETSC_FILE=petscOptions.split"
    "BASE=base/hex.snes NAME=hex_snes__laplacian  SOLIDPROPS_TAG=laplacian  PETSC_FILE=petscOptions.split"
    "BASE=base/hex.snes NAME=hex_snes__jst        SOLIDPROPS_TAG=jst        PETSC_FILE=petscOptions.split"
    "BASE=base/hex.snes NAME=hex_snes__evenlap_m0 SOLIDPROPS_TAG=evenlap_m0 PETSC_FILE=petscOptions.split"
    "BASE=base/hex.snes NAME=hex_snes__evenlap_m1 SOLIDPROPS_TAG=evenlap_m1 PETSC_FILE=petscOptions.split"
)

configTags=(rhiechow laplacian jst evenlap_m0 evenlap_m1)

# Define start and end mesh indices
# Override on the command line, e.g. END_MESH=7 ./Allrun
START_MESH=${START_MESH:-1}
END_MESH=${END_MESH:-7}


meshCellsPerSide()
{
    case "$1" in
        1) echo 3 ;;
        2) echo 6 ;;
        3) echo 12 ;;
        4) echo 24 ;;
        5) echo 48 ;;
        6) echo 96 ;;
        7) echo 192 ;;
        *)
            echo "NaN"
            ;;
    esac
}


detailField()
{
    local file="$1"
    local wantedMesh="$2"
    local fieldName="$3"

    case "${fieldName}" in
        cellsPerSide)
            awk -F'\t' -v wantedMesh="$wantedMesh" 'NR == 1 {next} $1 == wantedMesh {print $2; exit}' "$file"
            ;;
        cells)
            awk -F'\t' -v wantedMesh="$wantedMesh" 'NR == 1 {next} $1 == wantedMesh {print $3; exit}' "$file"
            ;;
        executionTime)
            awk -F'\t' -v wantedMesh="$wantedMesh" 'NR == 1 {next} $1 == wantedMesh {print $4; exit}' "$file"
            ;;
        clockTime)
            awk -F'\t' -v wantedMesh="$wantedMesh" 'NR == 1 {next} $1 == wantedMesh {print $5; exit}' "$file"
            ;;
        mem)
            awk -F'\t' -v wantedMesh="$wantedMesh" 'NR == 1 {next} $1 == wantedMesh {print $6; exit}' "$file"
            ;;
        dy)
            awk -F'\t' -v wantedMesh="$wantedMesh" 'NR == 1 {next} $1 == wantedMesh {print $7; exit}' "$file"
            ;;
        dyScaled)
            awk -F'\t' -v wantedMesh="$wantedMesh" 'NR == 1 {next} $1 == wantedMesh {print $8; exit}' "$file"
            ;;
        snesIterations)
            awk -F'\t' -v wantedMesh="$wantedMesh" 'NR == 1 {next} $1 == wantedMesh {print $9; exit}' "$file"
            ;;
        avgLinearIterations)
            awk -F'\t' -v wantedMesh="$wantedMesh" 'NR == 1 {next} $1 == wantedMesh {print $10; exit}' "$file"
            ;;
        linearSolves)
            awk -F'\t' -v wantedMesh="$wantedMesh" 'NR == 1 {next} $1 == wantedMesh {print $11; exit}' "$file"
            ;;
        status)
            awk -F'\t' -v wantedMesh="$wantedMesh" 'NR == 1 {next} $1 == wantedMesh {print $12; exit}' "$file"
            ;;
        exitCode)
            awk -F'\t' -v wantedMesh="$wantedMesh" 'NR == 1 {next} $1 == wantedMesh {print $13; exit}' "$file"
            ;;
    esac
}


numericDifference()
{
    local lhs="$1"
    local rhs="$2"

    awk -v lhsValue="$lhs" -v rhsValue="$rhs" 'BEGIN { if (lhsValue == "" || rhsValue == "" || lhsValue == "NaN" || rhsValue == "NaN") print "NaN"; else printf "%.12g", rhsValue - lhsValue }'
}


initialiseWideTable()
{
    local file="$1"
    local xHeader="$2"

    printf "%s" "${xHeader}" > "${file}"
    for tag in "${configTags[@]}"
    do
        printf "\t%s" "${tag}" >> "${file}"
    done
    printf "\n" >> "${file}"
}


appendWideTableRow()
{
    local file="$1"
    local xValue="$2"
    local mesh="$3"
    local metricName="$4"

    printf "%s" "${xValue}" >> "${file}"

    for tag in "${configTags[@]}"
    do
        local detailsFile="hex_snes__${tag}.details.tsv"
        local value
        value=$(detailField "${detailsFile}" "${mesh}" "${metricName}")

        if [[ -z "${value}" ]]
        then
            value="NaN"
        fi

        printf "\t%s" "${value}" >> "${file}"
    done

    printf "\n" >> "${file}"
}


# Detect the CPU type: we append this to the case name
if [[ "$OSTYPE" == "darwin"* ]]
then
    # macOS
    CPU_TYPE=$(sysctl -n machdep.cpu.brand_string 2>/dev/null | sed 's/[^a-zA-Z0-9]/_/g')
elif [[ -f /proc/cpuinfo ]]
then
    # Linux
    CPU_TYPE=$(grep -m 1 "model name" /proc/cpuinfo | awk -F': ' '{print $2}' | sed 's/[^a-zA-Z0-9]/_/g')
else
    # Fallback if neither method works
    CPU_TYPE="Unknown_CPU"
fi

if [[ -z "${CPU_TYPE}" ]]
then
    CPU_TYPE="Unknown_CPU"
fi


# Create timestamped working directory for this run
DATE=$(date +%Y%m%d_%H%M%S)
RUN_DIR="run_${CPU_TYPE}_${DATE}"
echo "Creating ${RUN_DIR}"
mkdir "${RUN_DIR}"

# Enter the run directory
cd "${RUN_DIR}" || exit 1

# Combined results file
RESULTS_TABLE="stabilisationResults.tsv"
echo -e "# Config\tMesh\tCellsPerSide\tCells\tExecutionTime\tClockTime\tMem\tDy\tDyScaled\tSNESIterations\tAvgLinearIterations\tLinearSolves\tStatus\tExitCode" > "${RESULTS_TABLE}"

# Iterate through configurations
for config in "${configs[@]}"
do
    # Parse the configuration string
    eval $config
    echo; echo "***************************************"
    echo "Running configuration: $config"
    echo "***************************************"

    # Define results summary file names
    SUMMARY="${NAME}.summary.txt"
    DETAILS="${NAME}.details.tsv"
    echo "# Mesh Time Mem D" > "${SUMMARY}"
    echo -e "# Mesh\tCellsPerSide\tCells\tExecutionTime\tClockTime\tMem\tDy\tDyScaled\tSNESIterations\tAvgLinearIterations\tLinearSolves\tStatus\tExitCode" > "${DETAILS}"

    # Loop over mesh densities in each configuration
    for i in `seq $START_MESH $END_MESH`
    do
        CASE="${NAME}.$i"
        echo; echo "Processing case: $CASE"

        CELLS_PER_SIDE=$(meshCellsPerSide "$i")
        if [[ -z "${CELLS_PER_SIDE}" ]]
        then
            CELLS_PER_SIDE="NaN"
        fi

        # Prepare the case
        cp -r "../${BASE}" "${CASE}"
        cd "$CASE" || exit 1

        STATUS="OK"
        EXIT_CODE=0
        MAX_MEMORY="NaN"
        EXECUTION_TIME="NaN"
        CLOCK_TIME="NaN"
        DISP="NaN"
        DISP_SCALED="NaN"
        SNES_ITERS="NaN"
        AVG_LINEAR_ITERS="NaN"
        LINEAR_SOLVES=0
        NCELLS="NaN"

        # Selecting stabilisation method i.e. Rhie-Chow, laplacian, JST,
        # even-order laplacian
        if [[ -n "${SOLIDPROPS_TAG:-}" ]]
        then
            SOLIDPROPS_FILE="constant/solidProperties.${SOLIDPROPS_TAG}"

            if [[ ! -f "$SOLIDPROPS_FILE" ]]
            then
                echo "ERROR: missing $SOLIDPROPS_FILE in $(pwd)"
                exit 1
            fi

            echo "Selecting stabilisation: ${SOLIDPROPS_TAG}"
            \cp "$SOLIDPROPS_FILE" constant/solidProperties
        fi

        # Replace the blockMeshDict
        if [[ ! -f "system/blockMeshDict.$i" ]]
        then
            echo "Cannot find ${CASE}/system/blockMeshDict.$i"; echo
            exit 1
        else
            echo "Copying ${CASE}/system/blockMeshDict.$i to ${CASE}/system/blockMeshDict"
            \cp "system/blockMeshDict.$i" system/blockMeshDict
            rm -f constant/polyMesh/blockMeshDict
        fi

        # Create the mesh
        solids4Foam::runApplication blockMesh
        BLOCKMESH_EXIT=$?

        if [[ -f log.blockMesh ]]
        then
            NCELLS=$(grep "nCells:" log.blockMesh | awk '{print $2}' | tail -n 1)
        fi

        # Update the PETSc options file
        if [[ -n "${PETSC_FILE}" ]]
        then
            sed -i "/^\s*optionsFile /s|^.*|    optionsFile ${PETSC_FILE};|" constant/solidProperties
        fi

        if [[ ${BLOCKMESH_EXIT} -eq 0 ]]
        then
            # Run the solver
            # If "gtime" is available (could be called "time" on Linux), use it to
            # record the max memory usage
            if command -v gtime &> /dev/null
            then
                echo "Running solids4Foam on ${CASE} with gtime"
                gtime -f "Maximum resident set size (kbytes): %M" solids4Foam &> log.solids4Foam
                EXIT_CODE=$?
            elif command -v time &> /dev/null
            then
                echo "Running solids4Foam on ${CASE} with time"
                /usr/bin/time -f "Maximum resident set size (kbytes): %M" solids4Foam &> log.solids4Foam
                EXIT_CODE=$?
            else
                echo "Running solids4Foam on ${CASE}"
                solids4Foam &> log.solids4Foam
                EXIT_CODE=$?
            fi

            # Extract results from solver log and append them to a summary file
            echo; echo "Appending results to ${SUMMARY}"
            if grep -q "Maximum resident" log.solids4Foam
            then
                MAX_MEMORY=$(grep "Maximum resident" log.solids4Foam | awk '{print int($6 / 1000)}')
            elif grep -q "maximum resident set size" log.solids4Foam
            then
                MAX_MEMORY=$(grep "maximum resident set size" log.solids4Foam | awk '{print int($1 / 1000)}')
            else
                MAX_MEMORY="NaN"
            fi

            EXECUTION_TIME=$(awk '/ExecutionTime =/ {value = $3} END {if (value != "") print value; else print "NaN"}' log.solids4Foam)
            CLOCK_TIME=$(awk '/ExecutionTime =/ {value = $7} END {if (value != "") print value; else print "NaN"}' log.solids4Foam)
            SNES_ITERS=$(awk '/Nonlinear solve converged/ {value = $NF} END {if (value != "") print value; else print "NaN"}' log.solids4Foam)
            LINEAR_SOLVES=$(awk '/Linear solve converged/ {count++} END {print count + 0}' log.solids4Foam)
            AVG_LINEAR_ITERS=$(awk '/Linear solve converged/ {sum += $NF; count++} END {if (count > 0) printf "%.12g", sum/count; else print "NaN"}' log.solids4Foam)

            # Extract the reference point vertical displacement
            if [[ -f postProcessing/0/solidPointDisplacement_pointDisp.dat ]]
            then
                DISP=$(tail -1 postProcessing/0/solidPointDisplacement_pointDisp.dat | awk '{print $3}')
            fi

            DISP_SCALED=$(awk -v d="$DISP" 'BEGIN {if (d == "" || d == "NaN") print "NaN"; else printf "%.12g", d*0.001}')

            if [[ ${EXIT_CODE} -ne 0 ]]
            then
                STATUS="SOLVER_FAILED"
            elif ! grep -q "End" log.solids4Foam
            then
                STATUS="INCOMPLETE"
            fi
        else
            STATUS="BLOCKMESH_FAILED"
            EXIT_CODE=${BLOCKMESH_EXIT}
        fi

        # Write data to files
        echo "$i $CLOCK_TIME $MAX_MEMORY $DISP" >> ../"${SUMMARY}"
        echo -e "${i}\t${CELLS_PER_SIDE}\t${NCELLS}\t${EXECUTION_TIME}\t${CLOCK_TIME}\t${MAX_MEMORY}\t${DISP}\t${DISP_SCALED}\t${SNES_ITERS}\t${AVG_LINEAR_ITERS}\t${LINEAR_SOLVES}\t${STATUS}\t${EXIT_CODE}" >> ../"${DETAILS}"
        echo -e "${SOLIDPROPS_TAG}\t${i}\t${CELLS_PER_SIDE}\t${NCELLS}\t${EXECUTION_TIME}\t${CLOCK_TIME}\t${MAX_MEMORY}\t${DISP}\t${DISP_SCALED}\t${SNES_ITERS}\t${AVG_LINEAR_ITERS}\t${LINEAR_SOLVES}\t${STATUS}\t${EXIT_CODE}" >> ../"${RESULTS_TABLE}"

        cd .. || exit 1
    done

    # Print summary file
    echo; echo "${SUMMARY} file:"; cat "${SUMMARY}"; echo
done

# Create wide tables for plotting and quick comparisons
initialiseWideTable tipDispVsCells.dat "cells"
initialiseWideTable tipDispScaledVsCellsPerSide.dat "cellsPerSide"
initialiseWideTable clockTimeVsCells.dat "cells"
initialiseWideTable executionTimeVsCells.dat "cells"
initialiseWideTable maxMemoryVsCells.dat "cells"
initialiseWideTable snesIterationsVsCells.dat "cells"
initialiseWideTable avgLinearIterationsVsCells.dat "cells"

for i in `seq $START_MESH $END_MESH`
do
    NCELLS=$(detailField hex_snes__laplacian.details.tsv "$i" cells)
    CELLS_PER_SIDE=$(detailField hex_snes__laplacian.details.tsv "$i" cellsPerSide)

    if [[ -z "${NCELLS}" ]]
    then
        NCELLS="NaN"
    fi

    if [[ -z "${CELLS_PER_SIDE}" || "${CELLS_PER_SIDE}" == "NaN" ]]
    then
        CELLS_PER_SIDE=$(meshCellsPerSide "$i")
    fi

    appendWideTableRow tipDispVsCells.dat "${NCELLS}" "${i}" dy
    appendWideTableRow tipDispScaledVsCellsPerSide.dat "${CELLS_PER_SIDE}" "${i}" dyScaled
    appendWideTableRow clockTimeVsCells.dat "${NCELLS}" "${i}" clockTime
    appendWideTableRow executionTimeVsCells.dat "${NCELLS}" "${i}" executionTime
    appendWideTableRow maxMemoryVsCells.dat "${NCELLS}" "${i}" mem
    appendWideTableRow snesIterationsVsCells.dat "${NCELLS}" "${i}" snesIterations
    appendWideTableRow avgLinearIterationsVsCells.dat "${NCELLS}" "${i}" avgLinearIterations
done

# Write a compact equivalence table for laplacian versus even-order m = 0
LAP_VS_E0="laplacian_vs_evenlap_m0.tsv"
echo -e "# Mesh\tCellsPerSide\tCells\tLapClockTime\tEvenM0ClockTime\tLapDyScaled\tEvenM0DyScaled\tLapSNESIterations\tEvenM0SNESIterations\tLapAvgLinearIterations\tEvenM0AvgLinearIterations\tClockTimeDiff\tDyScaledDiff\tSNESIterationDiff\tAvgLinearIterationDiff\tLapStatus\tEvenM0Status" > "${LAP_VS_E0}"

for i in `seq $START_MESH $END_MESH`
do
    CELLS_PER_SIDE=$(detailField hex_snes__laplacian.details.tsv "$i" cellsPerSide)
    NCELLS=$(detailField hex_snes__laplacian.details.tsv "$i" cells)
    LAP_T=$(detailField hex_snes__laplacian.details.tsv "$i" clockTime)
    E0_T=$(detailField hex_snes__evenlap_m0.details.tsv "$i" clockTime)
    LAP_D=$(detailField hex_snes__laplacian.details.tsv "$i" dyScaled)
    E0_D=$(detailField hex_snes__evenlap_m0.details.tsv "$i" dyScaled)
    LAP_SN=$(detailField hex_snes__laplacian.details.tsv "$i" snesIterations)
    E0_SN=$(detailField hex_snes__evenlap_m0.details.tsv "$i" snesIterations)
    LAP_AVG=$(detailField hex_snes__laplacian.details.tsv "$i" avgLinearIterations)
    E0_AVG=$(detailField hex_snes__evenlap_m0.details.tsv "$i" avgLinearIterations)
    LAP_STATUS=$(detailField hex_snes__laplacian.details.tsv "$i" status)
    E0_STATUS=$(detailField hex_snes__evenlap_m0.details.tsv "$i" status)

    TIME_DIFF=$(numericDifference "${LAP_T}" "${E0_T}")
    DISP_DIFF=$(numericDifference "${LAP_D}" "${E0_D}")
    SNES_DIFF=$(numericDifference "${LAP_SN}" "${E0_SN}")
    AVG_LINEAR_DIFF=$(numericDifference "${LAP_AVG}" "${E0_AVG}")

    echo -e "${i}\t${CELLS_PER_SIDE}\t${NCELLS}\t${LAP_T}\t${E0_T}\t${LAP_D}\t${E0_D}\t${LAP_SN}\t${E0_SN}\t${LAP_AVG}\t${E0_AVG}\t${TIME_DIFF}\t${DISP_DIFF}\t${SNES_DIFF}\t${AVG_LINEAR_DIFF}\t${LAP_STATUS}\t${E0_STATUS}" >> "${LAP_VS_E0}"
done

# Copy plotting inputs so the post-processing can be recreated from the run dir
cp "${PLOT_DIR}"/*.gnuplot .
cp "${BENCHMARK_FILE}" .
cp "${MESH_SPACING_FILE}" .

# Create plots if gnuplot is installed
if command -v gnuplot &>/dev/null
then
    if (gnuplot -e "set terminal dumb; set output '/dev/null'" &>/dev/null) 2>/dev/null
    then
        for f in *.gnuplot
        do
            echo "Running gnuplot on $f"
            gnuplot "$f"
        done
    else
        echo "Skipping gnuplot: installed binary is not runnable in this environment"
    fi
fi

# Exit the run directory
cd "${SCRIPT_DIR}" || exit 1

echo; echo; echo "Done!"; echo
echo "View the files in ${RUN_DIR}"
echo; echo $(date +%Y%m%d_%H%M%S)
echo; echo
