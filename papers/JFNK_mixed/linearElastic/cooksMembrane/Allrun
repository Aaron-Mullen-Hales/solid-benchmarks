#!/bin/bash

# Source required functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions
source solids4FoamScripts.sh

# Define configurations as space-separated strings
configs=(
    "BASE=base/hex.snes NAME=hex_snes__rhiechow   SOLIDPROPS_TAG=rhiechow   PETSC_FILE=petscOptions.split"
    "BASE=base/hex.snes NAME=hex_snes__laplacian  SOLIDPROPS_TAG=laplacian  PETSC_FILE=petscOptions.split"
    "BASE=base/hex.snes NAME=hex_snes__jst        SOLIDPROPS_TAG=jst        PETSC_FILE=petscOptions.split"
    "BASE=base/hex.snes NAME=hex_snes__evenlap_m0 SOLIDPROPS_TAG=evenlap_m0 PETSC_FILE=petscOptions.split"
    "BASE=base/hex.snes NAME=hex_snes__evenlap_m1 SOLIDPROPS_TAG=evenlap_m1 PETSC_FILE=petscOptions.split"
)

# Define start and end mesh indices
# Mesh input files are defined from 1 to 8
START_MESH=1
END_MESH=6


# Detect the CPU type: we append this to the case name
if [[ "$OSTYPE" == "darwin"* ]]
then
    # macOS
    CPU_TYPE=$(sysctl -n machdep.cpu.brand_string | sed 's/[^a-zA-Z0-9]/_/g')
elif [[ -f /proc/cpuinfo ]]
then
    # Linux
    CPU_TYPE=$(grep -m 1 "model name" /proc/cpuinfo | awk -F': ' '{print $2}' | sed 's/[^a-zA-Z0-9]/_/g')
else
    # Fallback if neither method works
    CPU_TYPE="Unknown_CPU"
fi


# Create timestamped working directory for this run
DATE=$(date +%Y%m%d_%H%M%S)
RUN_DIR="run_${CPU_TYPE}_${DATE}"
echo "Creating ${RUN_DIR}"
mkdir "${RUN_DIR}"

# Enter the run directory
cd "${RUN_DIR}"

# Combined results file
RESULTS_TABLE="stabilisationResults.tsv"
echo -e "# Config\tMesh\tCells\tTime\tMem\tD\tStatus\tExitCode" > "${RESULTS_TABLE}"

# Iterate through configurations
for config in "${configs[@]}"
do
    # Parse the configuration string
    eval $config
    echo; echo "***************************************"
    echo "Running configuration: $config"
    echo "***************************************"

    # Define results summary file names
    SUMMARY="${NAME}.summary.txt"
    DETAILS="${NAME}.details.tsv"
    echo "# Mesh Time Mem D" > "${SUMMARY}"
    echo -e "# Mesh\tCells\tTime\tMem\tD\tStatus\tExitCode" > "${DETAILS}"

    # Loop over mesh densities in each configuration
    for i in `seq $START_MESH $END_MESH`
    do
        CASE="${NAME}.$i"
        echo; echo "Processing case: $CASE"

        # Prepare the case
        cp -r "../${BASE}" "${CASE}"
        cd "$CASE"

        STATUS="OK"
        EXIT_CODE=0
        MAX_MEMORY="NaN"
        CLOCK_TIME="NaN"
        DISP="NaN"
        NCELLS="NaN"

        # Selecting stabilisation method i.e. Rhie-Chow, laplacian, JST,
        # even-order laplacian
        if [[ -n "${SOLIDPROPS_TAG:-}" ]]; then
            SOLIDPROPS_FILE="constant/solidProperties.${SOLIDPROPS_TAG}"

            if [[ ! -f "$SOLIDPROPS_FILE" ]]; then
                echo "ERROR: missing $SOLIDPROPS_FILE in $(pwd)"
                exit 1
            fi

            echo "Selecting stabilisation: ${SOLIDPROPS_TAG}"
            \cp "$SOLIDPROPS_FILE" constant/solidProperties
        fi

        # Replace the blockMeshDict
        if [[ ! -f "system/blockMeshDict.$i" ]]
        then
            echo "Cannot find ${CASE}/system/blockMeshDict.$i"; echo
            exit 1
        else
            echo "Copying ${CASE}/system/blockMeshDict.$i to ${CASE}/system/blockMeshDict"
            \cp "system/blockMeshDict.$i" system/blockMeshDict
            rm -f constant/polyMesh/blockMeshDict
        fi

        # Create the mesh
        solids4Foam::runApplication blockMesh
        BLOCKMESH_EXIT=$?

        if [[ -f log.blockMesh ]]; then
            NCELLS=$(grep "nCells:" log.blockMesh | awk '{print $2}' | tail -n 1)
        fi

        # Update the PETSc options file
        if [ -n "${PETSC_FILE}" ]; then
            sed -i "/^\s*optionsFile /s|^.*|    optionsFile ${PETSC_FILE};|" constant/solidProperties
        fi

        if [[ ${BLOCKMESH_EXIT} -eq 0 ]]
        then
            # Run the solver
            # If "gtime" is available (could be called "time" on Linux), use it to
            # record the max memory usage
            if command -v gtime &> /dev/null
            then
                echo "Running solids4Foam on ${CASE} with gtime"
                gtime -f "Maximum resident set size (kbytes): %M" solids4Foam &> log.solids4Foam
                EXIT_CODE=$?
            elif command -v time &> /dev/null
            then
                echo "Running solids4Foam on ${CASE} with time"
                /usr/bin/time -f "Maximum resident set size (kbytes): %M" solids4Foam &> log.solids4Foam
                EXIT_CODE=$?
            else
                echo "Running solids4Foam on ${CASE}"
                # Strange PETSc issue on Macbook where I need to use mpirun for serial
                #solids4Foam::runApplication solids4Foam
                #mpirun -np 1 solids4Foam &> log.solids4Foam
                solids4Foam &> log.solids4Foam
                EXIT_CODE=$?
            fi

            # Extract results from solver log and append them to a summary file
            echo; echo "Appending results to ${SUMMARY}"
            if grep -q "Maximum resident" log.solids4Foam; then
                MAX_MEMORY=$(grep "Maximum resident" log.solids4Foam | awk '{print int($6 / 1000)}')
            elif grep -q "maximum resident set size" log.solids4Foam; then
                MAX_MEMORY=$(grep "maximum resident set size" log.solids4Foam | awk '{print int($1 / 1000)}')
            else
                MAX_MEMORY="NaN"
            fi

            # Record the time
            CLOCK_TIME=$(grep "ClockTime" log.solids4Foam | tail -n 1 | awk '{print $7}')

            # Extract the reference point vertical displacement
            if [[ -f postProcessing/0/solidPointDisplacement_pointDisp.dat ]]; then
                DISP=$(tail -1 postProcessing/0/solidPointDisplacement_pointDisp.dat | awk '{print $3}')
            fi

            if [[ ${EXIT_CODE} -ne 0 ]]
            then
                STATUS="SOLVER_FAILED"
            elif ! grep -q "End" log.solids4Foam
            then
                STATUS="INCOMPLETE"
            fi
        else
            STATUS="BLOCKMESH_FAILED"
            EXIT_CODE=${BLOCKMESH_EXIT}
        fi

        # Write data to files
        echo "$i $CLOCK_TIME $MAX_MEMORY $DISP" >> ../"${SUMMARY}"
        echo -e "${i}\t${NCELLS}\t${CLOCK_TIME}\t${MAX_MEMORY}\t${DISP}\t${STATUS}\t${EXIT_CODE}" >> ../"${DETAILS}"
        echo -e "${SOLIDPROPS_TAG}\t${i}\t${NCELLS}\t${CLOCK_TIME}\t${MAX_MEMORY}\t${DISP}\t${STATUS}\t${EXIT_CODE}" >> ../"${RESULTS_TABLE}"

        cd ..
    done

    # Print summary file
    echo; echo "${SUMMARY} file:"; cat "${SUMMARY}"; echo
done

# Create wide tables for plotting
echo -e "cells\trhiechow\tlaplacian\tjst\tevenlap_m0\tevenlap_m1" > tipDispVsCells.dat
echo -e "cells\trhiechow\tlaplacian\tjst\tevenlap_m0\tevenlap_m1" > clockTimeVsCells.dat
echo -e "cells\trhiechow\tlaplacian\tjst\tevenlap_m0\tevenlap_m1" > maxMemoryVsCells.dat

for i in `seq $START_MESH $END_MESH`
do
    NCELLS=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $2; exit}' hex_snes__laplacian.details.tsv)
    RHIE_D=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $5; exit}' hex_snes__rhiechow.details.tsv)
    LAP_D=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $5; exit}' hex_snes__laplacian.details.tsv)
    JST_D=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $5; exit}' hex_snes__jst.details.tsv)
    E0_D=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $5; exit}' hex_snes__evenlap_m0.details.tsv)
    E1_D=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $5; exit}' hex_snes__evenlap_m1.details.tsv)

    RHIE_T=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $3; exit}' hex_snes__rhiechow.details.tsv)
    LAP_T=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $3; exit}' hex_snes__laplacian.details.tsv)
    JST_T=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $3; exit}' hex_snes__jst.details.tsv)
    E0_T=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $3; exit}' hex_snes__evenlap_m0.details.tsv)
    E1_T=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $3; exit}' hex_snes__evenlap_m1.details.tsv)

    RHIE_M=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $4; exit}' hex_snes__rhiechow.details.tsv)
    LAP_M=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $4; exit}' hex_snes__laplacian.details.tsv)
    JST_M=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $4; exit}' hex_snes__jst.details.tsv)
    E0_M=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $4; exit}' hex_snes__evenlap_m0.details.tsv)
    E1_M=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $4; exit}' hex_snes__evenlap_m1.details.tsv)

    echo -e "${NCELLS}\t${RHIE_D}\t${LAP_D}\t${JST_D}\t${E0_D}\t${E1_D}" >> tipDispVsCells.dat
    echo -e "${NCELLS}\t${RHIE_T}\t${LAP_T}\t${JST_T}\t${E0_T}\t${E1_T}" >> clockTimeVsCells.dat
    echo -e "${NCELLS}\t${RHIE_M}\t${LAP_M}\t${JST_M}\t${E0_M}\t${E1_M}" >> maxMemoryVsCells.dat
done

# Write a compact equivalence table for laplacian versus even-order m = 0
LAP_VS_E0="laplacian_vs_evenlap_m0.tsv"
echo -e "# Mesh\tCells\tLapTime\tEvenM0Time\tLapD\tEvenM0D\tTimeDiff\tDispDiff\tLapStatus\tEvenM0Status" > "${LAP_VS_E0}"

for i in `seq $START_MESH $END_MESH`
do
    NCELLS=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $2; exit}' hex_snes__laplacian.details.tsv)
    LAP_T=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $3; exit}' hex_snes__laplacian.details.tsv)
    E0_T=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $3; exit}' hex_snes__evenlap_m0.details.tsv)
    LAP_D=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $5; exit}' hex_snes__laplacian.details.tsv)
    E0_D=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $5; exit}' hex_snes__evenlap_m0.details.tsv)
    LAP_STATUS=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $6; exit}' hex_snes__laplacian.details.tsv)
    E0_STATUS=$(awk -v mesh="$i" 'NR > 1 && $1 == mesh {print $6; exit}' hex_snes__evenlap_m0.details.tsv)

    TIME_DIFF=$(awk -v a="$LAP_T" -v b="$E0_T" 'BEGIN {if (a == "" || b == "" || a == "NaN" || b == "NaN") print "NaN"; else printf "%.12g", b - a}')
    DISP_DIFF=$(awk -v a="$LAP_D" -v b="$E0_D" 'BEGIN {if (a == "" || b == "" || a == "NaN" || b == "NaN") print "NaN"; else printf "%.12g", b - a}')

    echo -e "${i}\t${NCELLS}\t${LAP_T}\t${E0_T}\t${LAP_D}\t${E0_D}\t${TIME_DIFF}\t${DISP_DIFF}\t${LAP_STATUS}\t${E0_STATUS}" >> "${LAP_VS_E0}"
done

# Create plots if gnuplot in installed
if command -v gnuplot &>/dev/null
then
    # Copy gnuplot scripts
    cp ../plotScripts/* .

    # Run all scripts
    for f in *gnuplot
    do
        echo "Running gnuplot on $f"
        gnuplot "$f"
    done
fi

# Exit the run directory
cd ..

echo; echo; echo "Done!"; echo
echo "View the files in ${RUN_DIR}"
echo; echo $(date +%Y%m%d_%H%M%S)
echo; echo
