#!/bin/bash

# Source required functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions
source solids4FoamScripts.sh

set -u

# Usage:
#   ./Allrun [mesh|time|all|smoke]
#
# Environment overrides:
#   METHODS="monolithic:default monolithic:schurTuned partitioned:IQNILS"
#   MESH_LEVELS="1 2 3"
#   DT_VALUES="2e-3 1e-3 5e-4"
#   END_TIME=20
#   FORCE_SCALE=1.0    # 1/0.015 to convert from 15 mm extruded slab to 2D N/m
#   START_FRAC=0.5     # trailing-window fraction for last-period stats

STUDY="${1:-${STUDY:-mesh}}"
END_TIME="${END_TIME:-20}"
FORCE_SCALE="${FORCE_SCALE:-1.0}"
START_FRAC="${START_FRAC:-0.5}"

DEFAULT_METHODS="monolithic:default monolithic:schurTuned monolithic:physicsPC partitioned:IQNILS partitioned:Aitken"
if [[ -n "${METHODS+x}" ]]
then
    USER_SET_METHODS=true
else
    USER_SET_METHODS=false
    METHODS="$DEFAULT_METHODS"
fi

case "$STUDY" in
    mesh)
        MESH_LEVELS="${MESH_LEVELS:-1 2 3}"
        DT_VALUES="${DT_VALUES:-1e-3}"
        ;;
    time)
        MESH_LEVELS="${MESH_LEVELS:-2}"
        DT_VALUES="${DT_VALUES:-2e-3 1e-3 5e-4 2.5e-4}"
        ;;
    all)
        MESH_LEVELS="${MESH_LEVELS:-1 2 3}"
        DT_VALUES="${DT_VALUES:-2e-3 1e-3 5e-4 2.5e-4}"
        ;;
    smoke)
        MESH_LEVELS="${MESH_LEVELS:-1}"
        DT_VALUES="${DT_VALUES:-1e-3}"
        END_TIME="${END_TIME_SMOKE:-${END_TIME:-0.1}}"
        if [[ "$END_TIME" == "20" ]]
        then
            END_TIME="0.1"
        fi
        if ! $USER_SET_METHODS
        then
            METHODS="monolithic:default partitioned:IQNILS"
        fi
        ;;
    *)
        echo "Unknown study '$STUDY'; expected mesh, time, all, or smoke"
        exit 1
        ;;
esac

methodBase()
{
    local method="$1"

    if [[ "$method" == "monolithic" ]]
    then
        echo "base/quasiMonolitic"
    else
        echo "base/partitioned"
    fi
}

caseName()
{
    local method="$1"
    local variant="$2"
    local mesh="$3"
    local dt="$4"

    echo "${method}_${variant}.m${mesh}.dt${dt//./p}"
}

activateMethod()
{
    local method="$1"
    local variant="$2"

    if [[ "$method" == "monolithic" ]]
    then
        for file in $(find ./0 ./constant ./system -name '*.monolithic')
        do
            ln -vnsf "${file##*/}" "${file%.*}"
        done

        if [[ "$variant" != "default" ]]
        then
            local variantFile="system/fvSolution.monolithic.${variant}"

            if [[ -f "$variantFile" ]]
            then
                ln -vnsf "fvSolution.monolithic.${variant}" system/fvSolution
            else
                echo "Cannot find $variantFile"
                return 1
            fi
        fi
    else
        for file in $(find ./0 ./constant ./system -name '*.partitioned')
        do
            ln -vnsf "${file##*/}" "${file%.*}"
        done

        sed -i \
            "/^[[:space:]]*fluidSolidInterface[[:space:]]/s|^.*|fluidSolidInterface    ${variant};|" \
            constant/fsiProperties
    fi
}

runSolver()
{
    if command -v gtime &> /dev/null
    then
        gtime -f "gtime/time (wall clock) time: %e\nMaximum resident set size (kbytes): %M" \
            solids4Foam &> log.solids4Foam
    elif [ -x /usr/bin/time ]
    then
        /usr/bin/time -f "gtime/time (wall clock) time: %e\nMaximum resident set size (kbytes): %M" \
            solids4Foam &> log.solids4Foam
    else
        solids4Foam &> log.solids4Foam
    fi
}

verifyConformalInterface()
{
    # Returns 0 if fluid plate face count == solid plate face count.
    local fluidFaces=""
    local solidFaces=""

    if [[ -f log.checkMesh.fluid ]]
    then
        fluidFaces=$(awk '/^[[:space:]]+plate[[:space:]]/ {print $2; exit}' \
                          log.checkMesh.fluid)
    fi

    if [[ -f log.checkMesh.solid ]]
    then
        solidFaces=$(awk '/^[[:space:]]+plate[[:space:]]/ {print $2; exit}' \
                          log.checkMesh.solid)
    fi

    echo "Plate faces: fluid=${fluidFaces:-?}, solid=${solidFaces:-?}"

    if [[ -n "$fluidFaces" && -n "$solidFaces" && "$fluidFaces" == "$solidFaces" ]]
    then
        return 0
    fi
    return 1
}

appendSummary()
{
    local summary="$1"
    local study="$2"
    local method="$3"
    local variant="$4"
    local case="$5"
    local mesh="$6"
    local deltaX="$7"
    local dt="$8"
    local status="$9"

    local clockTime="NaN"
    local maxMemory="NaN"
    local cellsFluid="NaN"
    local cellsSolid="NaN"
    local stats="NaN NaN NaN NaN NaN NaN NaN NaN NaN NaN NaN NaN"

    if grep -q "gtime/time" log.solids4Foam 2>/dev/null
    then
        clockTime=$(grep "gtime/time" log.solids4Foam | tail -1 | awk '{print $5}')
    elif [[ -f log.solids4Foam ]]
    then
        clockTime=$(grep "ClockTime" log.solids4Foam | tail -1 | awk '{print $7}')
    fi

    if grep -q "Maximum resident" log.solids4Foam 2>/dev/null
    then
        maxMemory=$(grep "Maximum resident" log.solids4Foam | tail -1 | awk '{print int($6 / 1000)}')
    fi

    if [[ -f log.checkMesh.fluid ]]
    then
        cellsFluid=$(grep "cells:" log.checkMesh.fluid | tail -1 | awk '{print $2}')
    fi

    if [[ -f log.checkMesh.solid ]]
    then
        cellsSolid=$(grep "cells:" log.checkMesh.solid | tail -1 | awk '{print $2}')
    fi

    if [[ -d postProcessing ]]
    then
        local got
        got=$(python3 ../../extractLastPeriod.py . \
                 --force-scale "$FORCE_SCALE" --start-frac "$START_FRAC" 2>/dev/null \
              || echo "")
        if [[ -n "$got" ]]
        then
            stats="$got"
        fi
    fi

    echo "${study} ${method} ${variant} ${case} ${mesh} ${deltaX} ${dt} ${status} ${cellsFluid} ${cellsSolid} ${clockTime} ${maxMemory} ${stats}" \
        >> "../${summary}"
}

# Detect the CPU type: append this to the run directory name
if [[ "$OSTYPE" == "darwin"* ]]
then
    CPU_TYPE=$(sysctl -n machdep.cpu.brand_string 2>/dev/null | sed 's/[^a-zA-Z0-9]/_/g')
elif [[ -f /proc/cpuinfo ]]
then
    CPU_TYPE=$(grep -m 1 "model name" /proc/cpuinfo | awk -F': ' '{print $2}' | sed 's/[^a-zA-Z0-9]/_/g')
else
    CPU_TYPE="Unknown_CPU"
fi

if [[ -z "$CPU_TYPE" ]]
then
    CPU_TYPE="$(uname -m)"
fi

DATE=$(date +%Y-%m-%d_%H-%M-%S)
RUN_DIR="run_${STUDY}_${CPU_TYPE}_${DATE}"
SUMMARY="campaignSummary.tsv"

echo "Creating ${RUN_DIR}"
mkdir "${RUN_DIR}"
cd "${RUN_DIR}"

echo "# Study Method Variant Case Mesh DeltaX DeltaT Status CellsFluid CellsSolid WallTime MaxMemoryMb UxMean UxAmp UxFreq UyMean UyAmp UyFreq FxMean FxAmp FxFreq FyMean FyAmp FyFreq" \
    > "$SUMMARY"

for methodVariant in $METHODS
do
    METHOD="${methodVariant%%:*}"
    VARIANT="${methodVariant#*:}"
    BASE="$(methodBase "$METHOD")"

    for mesh in $MESH_LEVELS
    do
        # Plate-thickness cell size in mm. Level 1 has 5 cells over 20 mm => 4 mm.
        # Each refinement halves the cell size.
        DELTAX=$(awk -v i="$mesh" 'BEGIN {printf "%.12g", 4.0/(2^(i - 1))}')

        for dt in $DT_VALUES
        do
            CASE="$(caseName "$METHOD" "$VARIANT" "$mesh" "$dt")"

            echo
            echo "***************************************"
            echo "Processing case: $CASE"
            echo "Method: $METHOD, variant: $VARIANT, mesh: $mesh, deltaT: $dt, endTime: $END_TIME"
            echo "***************************************"

            cp -rL "../${BASE}" "$CASE"
            cd "$CASE"

            STATUS="failed"

            if activateMethod "$METHOD" "$VARIANT"
            then
                cp "system/solid/blockMeshDict.${mesh}" system/solid/blockMeshDict
                cp "system/fluid/blockMeshDict.${mesh}" system/fluid/blockMeshDict

                sed -i "/^[[:space:]]*deltaT[[:space:]]/s|^.*|deltaT          ${dt};|" system/controlDict
                sed -i "/^[[:space:]]*endTime[[:space:]]/s|^.*|endTime         ${END_TIME};|" system/controlDict

                solids4Foam::runApplication -s solid blockMesh -region solid
                solids4Foam::runApplication -s fluid blockMesh -region fluid
                solids4Foam::runApplication -s fluid checkMesh -region fluid
                solids4Foam::runApplication -s solid checkMesh -region solid

                if ! verifyConformalInterface
                then
                    echo "Conformal-interface check failed; aborting case."
                    STATUS="failed"
                else
                    runSolver
                    SOLVER_STATUS=$?

                    if [[ $SOLVER_STATUS -ne 0 ]]
                    then
                        STATUS="failed"
                    else
                        STATUS="ranToEnd"
                    fi
                fi
            fi

            appendSummary "$SUMMARY" "$STUDY" "$METHOD" "$VARIANT" "$CASE" "$mesh" "$DELTAX" "$dt" "$STATUS"

            echo
            tail -n 5 "../${SUMMARY}"
            cd ..
        done
    done
done

if command -v gnuplot &>/dev/null
then
    cp ../plotScripts/campaign*.gnuplot . 2>/dev/null || true

    for f in campaign*.gnuplot
    do
        [[ -f "$f" ]] || continue
        echo "Running gnuplot on $f"
        gnuplot -c "$f" "$SUMMARY"
    done
fi

cd ..

echo
echo "Done"
echo "Run directory: ${RUN_DIR}"
echo "Summary: ${RUN_DIR}/${SUMMARY}"
echo
echo "$(date)"
