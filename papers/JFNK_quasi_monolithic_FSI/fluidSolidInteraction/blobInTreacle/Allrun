#!/bin/bash

# Source required functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions
source solids4FoamScripts.sh

set -u

# Usage:
#   ./Allrun [mesh|time|all|smoke]
#
# Environment overrides:
#   METHODS="monolithic:default partitioned:IQNILS partitioned:Aitken"
#   MESH_LEVELS="1 2 3 4 5"
#   DT_VALUES="0.1 0.025 0.0125 0.00625"
#   END_TIME=1
#   WRITE_INTERVAL=0.1

STUDY="${1:-${STUDY:-smoke}}"
WRITE_INTERVAL="${WRITE_INTERVAL:-0.1}"

DEFAULT_METHODS="monolithic:default partitioned:IQNILS partitioned:Aitken"
if [[ -v METHODS ]]
then
    USER_SET_METHODS=true
else
    USER_SET_METHODS=false
    METHODS="$DEFAULT_METHODS"
fi

case "$STUDY" in
    mesh)
        MESH_LEVELS="${MESH_LEVELS:-1 2 3 4 5}"
        DT_VALUES="${DT_VALUES:-0.00625}"
        END_TIME="${END_TIME:-1}"
        ;;
    time)
        MESH_LEVELS="${MESH_LEVELS:-3}"
        DT_VALUES="${DT_VALUES:-0.1 0.025 0.0125 0.00625}"
        END_TIME="${END_TIME:-1}"
        ;;
    all)
        MESH_LEVELS="${MESH_LEVELS:-1 2 3 4 5}"
        DT_VALUES="${DT_VALUES:-0.1 0.025 0.0125 0.00625}"
        END_TIME="${END_TIME:-1}"
        ;;
    smoke)
        MESH_LEVELS="${MESH_LEVELS:-1}"
        DT_VALUES="${DT_VALUES:-0.1}"
        END_TIME="${END_TIME:-0.1}"
        if ! $USER_SET_METHODS
        then
            METHODS="monolithic:default partitioned:IQNILS"
        fi
        ;;
    *)
        echo "Unknown study '$STUDY'; expected mesh, time, all, or smoke"
        exit 1
        ;;
esac

methodBase()
{
    local method="$1"

    if [[ "$method" == "monolithic" ]]
    then
        echo "base/quasiMonolitic"
    else
        echo "base/partitioned"
    fi
}

caseName()
{
    local method="$1"
    local variant="$2"
    local mesh="$3"
    local dt="$4"

    echo "${method}_${variant}.m${mesh}.dt${dt//./p}"
}

setControlEntry()
{
    local key="$1"
    local value="$2"
    local file="$3"

    foamDictionary "$file" -entry "$key" -set "$value" > /dev/null 2>&1
}

activateMethod()
{
    local method="$1"
    local variant="$2"

    if [[ "$method" == "partitioned" ]]
    then
        sed -i \
            "/^[[:space:]]*fluidSolidInterface[[:space:]]/s|^.*|fluidSolidInterface    ${variant};|" \
            constant/fsiProperties
    fi
}

runSolver()
{
    if command -v gtime &> /dev/null
    then
        gtime -f "gtime/time (wall clock) time: %e\nMaximum resident set size (kbytes): %M" \
            solids4Foam &> log.solids4Foam
    elif [ -x /usr/bin/time ]
    then
        /usr/bin/time -f "gtime/time (wall clock) time: %e\nMaximum resident set size (kbytes): %M" \
            solids4Foam &> log.solids4Foam
    else
        solids4Foam &> log.solids4Foam
    fi
}

appendSummary()
{
    local summary="$1"
    local study="$2"
    local method="$3"
    local variant="$4"
    local case="$5"
    local mesh="$6"
    local dt="$7"
    local status="$8"

    local clockTime="NaN"
    local maxMemory="NaN"
    local cellsFluid="NaN"
    local cellsSolid="NaN"
    local sampleTime="NaN"
    local dx="NaN"
    local dy="NaN"
    local magD="NaN"
    local fx="NaN"
    local fy="NaN"
    local fmag="NaN"

    if grep -q "gtime/time" log.solids4Foam
    then
        clockTime=$(grep "gtime/time" log.solids4Foam | tail -1 | awk '{print $5}')
    else
        clockTime=$(grep "ClockTime" log.solids4Foam | tail -1 | awk '{print $7}')
    fi

    if grep -q "Maximum resident" log.solids4Foam
    then
        maxMemory=$(grep "Maximum resident" log.solids4Foam | tail -1 | awk '{print int($6 / 1000)}')
    fi

    if [[ -f log.checkMesh.fluid ]]
    then
        cellsFluid=$(grep "cells:" log.checkMesh.fluid | tail -1 | awk '{print $2}')
    fi

    if [[ -f log.checkMesh.solid ]]
    then
        cellsSolid=$(grep "cells:" log.checkMesh.solid | tail -1 | awk '{print $2}')
    fi

    if [[ -f postProcessing/0/solidPointDisplacement_displacement.dat ]]
    then
        read -r sampleTime dx dy _ magD <<< \
            "$(awk 'NF && $1 !~ /^#/ {line=$0} END {print line}' postProcessing/0/solidPointDisplacement_displacement.dat)"
    fi

    if [[ -f postProcessing/fluid/forces/0/force.dat ]]
    then
        read -r _ fx fy _ <<< \
            "$(awk 'NF && $1 !~ /^#/ {line=$0} END {print line}' postProcessing/fluid/forces/0/force.dat)"
        fmag=$(awk -v fx="$fx" -v fy="$fy" 'BEGIN {print sqrt(fx*fx + fy*fy)}')
    fi

    echo "${study} ${method} ${variant} ${case} ${mesh} ${dt} ${END_TIME} ${status} ${cellsFluid} ${cellsSolid} ${clockTime} ${maxMemory} ${sampleTime} ${dx} ${dy} ${magD} ${fx} ${fy} ${fmag}" \
        >> "../${summary}"
}

if [[ "$OSTYPE" == "darwin"* ]]
then
    CPU_TYPE=$(sysctl -n machdep.cpu.brand_string | sed 's/[^a-zA-Z0-9]/_/g')
elif [[ -f /proc/cpuinfo ]]
then
    CPU_TYPE=$(grep -m 1 "model name" /proc/cpuinfo | awk -F': ' '{print $2}' | sed 's/[^a-zA-Z0-9]/_/g')
else
    CPU_TYPE="Unknown_CPU"
fi

DATE=$(date +%Y-%m-%d_%H-%M-%S)
RUN_DIR="run_${STUDY}_${CPU_TYPE}_${DATE}"
SUMMARY="campaignSummary.tsv"

echo "Creating ${RUN_DIR}"
mkdir "${RUN_DIR}"
cd "${RUN_DIR}"

echo "# Study Method Variant Case Mesh DeltaT EndTime Status CellsFluid CellsSolid WallTime MaxMemoryMb SampleTime TopPointDx TopPointDy TopPointDispMag Fx Fy Fmag" \
    > "$SUMMARY"

for methodVariant in $METHODS
do
    METHOD="${methodVariant%%:*}"
    VARIANT="${methodVariant#*:}"
    BASE="$(methodBase "$METHOD")"

    for mesh in $MESH_LEVELS
    do
        for dt in $DT_VALUES
        do
            CASE="$(caseName "$METHOD" "$VARIANT" "$mesh" "$dt")"

            echo
            echo "***************************************"
            echo "Processing case: $CASE"
            echo "Method: $METHOD, variant: $VARIANT, mesh: $mesh, deltaT: $dt"
            echo "***************************************"

            cp -rL "../${BASE}" "$CASE"
            cd "$CASE"

            STATUS="failed"

            activateMethod "$METHOD" "$VARIANT"
            setControlEntry deltaT "$dt" system/controlDict
            setControlEntry endTime "$END_TIME" system/controlDict
            setControlEntry writeInterval "$WRITE_INTERVAL" system/controlDict

            solids4Foam::runApplication -s solid blockMesh -region solid -dict system/solid/blockMeshDict."$mesh"
            solids4Foam::runApplication -s fluid blockMesh -region fluid -dict system/fluid/blockMeshDict."$mesh"
            solids4Foam::runApplication -s solid transformPoints -region solid -translate "(1.5 -0.5 0)"
            solids4Foam::runApplication -s fluid transformPoints -region fluid -translate "(1.5 -0.5 0)"
            solids4Foam::runApplication -s fluid checkMesh -region fluid
            solids4Foam::runApplication -s solid checkMesh -region solid

            runSolver
            SOLVER_STATUS=$?

            if [[ $SOLVER_STATUS -eq 0 ]] && grep -q "^End$" log.solids4Foam
            then
                STATUS="completed"
            fi

            appendSummary "$SUMMARY" "$STUDY" "$METHOD" "$VARIANT" "$CASE" "$mesh" "$dt" "$STATUS"

            echo
            tail -n 5 "../${SUMMARY}"
            cd ..
        done
    done
done

cd ..

echo
echo "Done"
echo "Run directory: ${RUN_DIR}"
echo "Summary: ${RUN_DIR}/${SUMMARY}"
echo
echo "$(date)"
